#!/usr/bin/env bash
# Fast, offline checks on staged files. See CONTRIBUTING.md.
set -euo pipefail

status=0
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md')

for f in "${files[@]}"; do
  # Check the staged version, not the working copy.
  content="$(git show ":$f")"

  if hits="$(printf '%s\n' "$content" | grep -nP '[\x{2013}\x{2014}]')"; then
    echo "pre-commit: $f contains em or en dashes:" >&2
    printf '  %s\n' "$hits" >&2
    status=1
  fi
done

# README table rows: the first column must be a known label.
if printf '%s\n' "${files[@]}" | grep -qx 'README.md'; then
  labels='Core|Alt|Ref|Practice|Read|Paid'
  if bad="$(git show :README.md | grep -nE '^\| [^|]+ \| \[' | grep -vE "^[0-9]+:\| ($labels) \| ")"; then
    echo "pre-commit: README.md rows with an unknown label (allowed: ${labels//|/, }):" >&2
    printf '  %s\n' "$bad" >&2
    status=1
  fi
  if bad="$(git show :README.md | grep -nE '\]\((http://|https?://[^)]* )')"; then
    echo "pre-commit: README.md has http:// links or URLs containing spaces:" >&2
    printf '  %s\n' "$bad" >&2
    status=1
  fi
fi

exit $status
