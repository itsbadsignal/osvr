#!/usr/bin/env python3
"""Build-time: turn the plain key (name asan_code asan_runtime ubsan debug_info opt per line) into salted hashes."""
import hashlib, os, secrets, sys
FIELDS = ["asan_code", "asan_runtime", "ubsan", "debug_info", "opt"]
plain, out = sys.argv[1], sys.argv[2]
salt = secrets.token_hex(8)
hs = []
for line in open(plain):
    p = line.split()
    if len(p) == 6:
        for f, v in zip(FIELDS, p[1:]):
            hs.append(hashlib.sha256(f"{salt}|{p[0]}|{f}|{v}".encode()).hexdigest())
open(out, "w").write(salt + "\n" + "\n".join(sorted(hs)) + "\n")
