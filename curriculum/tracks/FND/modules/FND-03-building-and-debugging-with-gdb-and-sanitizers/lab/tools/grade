#!/usr/bin/env python3
"""grade challenge [BUILD] [CHALDIR]   grade project [SCRIPT]   grade health LABTESTS
Runs inside the osvr-fnd03 image. The learner's files are mounted READ-ONLY: this tool never writes
to them (ctest is not run; the registered test executables are run directly). PASS/FAIL lines only;
it does not explain the defect and never prints an expected answer.
Exit: 0 all passed, 1 something failed, 2 usage."""
import glob, hashlib, json, os, re, shutil, subprocess, sys, tempfile

fails = 0
ENV = dict(os.environ)
ENV.pop("CFLAGS", None)  # ambient CFLAGS is ignored


def ok(m): print("PASS ", m)


def bad(m):
    global fails
    fails += 1
    print("FAIL ", m)


def run(cmd, **kw):
    kw.setdefault("timeout", 120)
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace", env=kw.pop("env", ENV), **kw)


def count(path, pat):
    o = run(["nm", "-D", path]).stdout
    return len([l for l in o.splitlines() if pat in l])


def ctest_list(build):
    p = run(["ctest", "--show-only=json-v1"], cwd=build)
    try:
        return json.loads(p.stdout)["tests"]
    except Exception:
        return None


def cache_val(build, key):
    try:
        for l in open(os.path.join(build, "CMakeCache.txt"), errors="replace"):
            if l.startswith(key + ":") or l.startswith(key + "="):
                return l.split("=", 1)[1].strip()
    except OSError:
        pass
    return None


def tests_of(build):
    t = ctest_list(build)
    out = []
    for x in t or []:
        cmd = x["command"][0]
        wd = next((p["value"] for p in x.get("properties", []) if p["name"] == "WORKING_DIRECTORY"), build)
        exe = cmd if os.path.isabs(cmd) else os.path.normpath(os.path.join(wd, cmd))
        out.append((x["name"], exe, wd))
    return out


def check_instrumentation(build):
    ts = tests_of(build)
    if not ts:
        bad("tests: ctest lists no tests in the build directory (tests enabled?)")
        return False
    allok = True
    libs = sorted(glob.glob(os.path.join(build, "libcjson.so.*.*"))) or sorted(glob.glob(os.path.join(build, "libcjson.so*")))
    targets = [(n, e) for n, e, _ in ts] + ([("libcjson", libs[0])] if libs else [])
    if not libs:
        bad("libcjson: no shared library found in the build directory")
        allok = False
    for n, e in targets:
        if not os.path.isfile(e):
            bad(f"instrumentation: {n}: binary not built"); return False
        a, u = count(e, "__asan_report"), count(e, "__ubsan_handle")
        ld = run(["ldd", e]).stdout
        missing = [w for w, c in (("__asan_report symbols", a > 0), ("__ubsan_handle symbols", u > 0), ("libasan linked", "libasan" in ld), ("libubsan linked", "libubsan" in ld)) if not c]
        if missing and n != "libcjson":
            bad(f"instrumentation: first offender is {n}"); return False
        if n == "libcjson" and (a == 0 or u == 0):
            bad("instrumentation: first offender is libcjson"); return False
    if allok:
        ok(f"instrumentation: {len(ts)} test executables and libcjson have ASan and UBSan symbols; runtimes linked")
    return allok


def check_compile_commands(build):
    cc = os.path.join(build, "compile_commands.json")
    if not os.path.isfile(cc):
        bad("compile_commands.json: not found in the build directory"); return False
    ents = json.load(open(cc))
    sel = [e for e in ents if e["file"].endswith("/cJSON.c") or re.search(r"/tests/[^/]+\.c$", e["file"])]
    if not sel:
        bad("compile_commands.json: no entry for cJSON.c or tests/*.c"); return False
    for e in sel:
        c = e.get("command") or " ".join(e.get("arguments", []))
        toks = c.split()
        o = [t for t in toks if re.match(r"-O", t)]
        why = None
        if "-g" not in toks: why = "-g"
        elif "-fno-omit-frame-pointer" not in toks: why = "-fno-omit-frame-pointer"
        elif o and o[-1] != "-O0": why = "-O0"
        if why:
            bad(f"compile flags: {os.path.basename(e['file'])} lacks {why}"); return False
    ok(f"compile flags: {len(sel)} compile commands carry -g, -fno-omit-frame-pointer and -O0")
    return True


def used_flags(build):
    """Flags the build really used for cJSON.c / tests/parse_examples.c, from compile_commands.json.
    Keeps -f*, -O*, -g*, -m* tokens only (drops compiler, -c, -o, sources, -I/-D, warnings, -std)."""
    cc = os.path.join(build, "compile_commands.json")
    try:
        ents = json.load(open(cc))
    except (OSError, ValueError):
        return None
    for e in ents:
        if e["file"].endswith("/cJSON.c") or e["file"].endswith("/tests/parse_examples.c"):
            toks = (e.get("command") or " ".join(e.get("arguments", []))).split()
            return [t for t in toks[1:] if re.match(r"-(f|O|g|m)", t)]
    return None


def check_ubsan_fatal(build):
    flags = used_flags(build)
    if flags is None:
        bad("ubsan fatal: no compile_commands.json entry for cJSON.c or tests/parse_examples.c to take the flags from")
        return False
    t = tempfile.mkdtemp()
    c = run(["gcc"] + flags + ["/opt/osvr/fnd03/src/ubtrip.c", "-o", t + "/u"])
    if not os.path.exists(t + "/u"):
        bad("ubsan fatal: the flags your build used do not compile the UBSan tripwire"); shutil.rmtree(t); return False
    p = run([t + "/u"], env=dict(ENV, ASAN_OPTIONS="detect_leaks=0"))
    shutil.rmtree(t)
    if p.returncode != 0 and "runtime error:" in p.stdout:
        ok(f"ubsan fatal: tripwire built with the flags your build used exits {p.returncode} with a runtime error line"); return True
    bad("ubsan fatal: UBSan findings would not fail a test (tripwire exit status 0 or no report)")
    return False


def check_tests_pass(build):
    ts = tests_of(build)
    failed = []
    for n, e, wd in ts:
        p = run([e], cwd=wd, env=dict(ENV, ASAN_OPTIONS="abort_on_error=0"))
        if p.returncode != 0:
            failed.append(n)
    if ts and not failed:
        ok(f"tests: all {len(ts)} registered tests exit 0 (run directly, read-only)"); return True
    bad(f"tests: {len(failed)} of {len(ts)} failed; first: {failed[0] if failed else 'none registered'}")
    return False


def gdb_truth(build):
    """Ground truth from the learner's own binary: first entry to cJSON.c:parse_number in parse_examples."""
    ts = {n: (e, wd) for n, e, wd in tests_of(build)}
    if "parse_examples" not in ts:
        return None, "parse_examples is not a registered test"
    e, wd = ts["parse_examples"]
    cmd = ["gdb", "-nx", "-batch", "-ex", "set pagination off", "-ex", "break cJSON.c:parse_number", "-ex", "run",
           "-ex", "bt", "-ex", "set $it = item", "-ex", "finish",
           "-ex", 'printf "KEY=%s\\nVAL=%g\\n", $it->string, $it->valuedouble', e]
    p = run(cmd, cwd=wd, env=dict(ENV, ASAN_OPTIONS="detect_leaks=0"), timeout=120)
    o = p.stdout
    frames = re.findall(r"^#(\d+)\s+(?:0x[0-9a-f]+ in )?(\S+) \((.*)$", o, re.M)
    if not frames:
        return None, "gdb could not stop in cJSON.c:parse_number (built with -g?)"
    names = [f[1] for f in frames]
    tf = None
    if "UnityDefaultTestRun" in names:
        i = names.index("UnityDefaultTestRun")
        tf = names[i - 1] if i > 0 else None
    inp = re.search(r'parse_file \(filename=[^"]*"([^"]*)"', o)
    key = re.search(r"^KEY=(.*)$", o, re.M)
    val = re.search(r"^VAL=(.*)$", o, re.M)
    if not (tf and inp and key and val):
        return None, "gdb transcript lacks the expected frames or values"
    return {"test_function": tf, "input_file": inp.group(1), "json_key": key.group(1), "parsed_value": val.group(1)}, None


def check_answers(build, chal):
    f = os.path.join(chal, "answers.md")
    if not os.path.isfile(f):
        bad("answers.md: not found"); return False
    got = {}
    for l in open(f, errors="replace"):
        m = re.match(r"\s*(test_function|input_file|json_key|parsed_value)\s*:\s*(.*?)\s*$", l, re.I)
        if m and m.group(1).lower() not in got:
            got[m.group(1).lower()] = m.group(2).strip("` ")
    truth, err = gdb_truth(build)
    if truth is None:
        bad(f"answers.md: cannot derive reference from your build: {err}"); return False
    good = True
    for k in ("test_function", "input_file", "json_key", "parsed_value"):
        v = got.get(k)
        if v is None:
            bad(f"answers.md {k}: missing"); good = False; continue
        t = truth[k]
        if k == "input_file":
            m = v.endswith(t) or v.endswith("inputs/test3") and t.endswith("inputs/test3")
        elif k == "parsed_value":
            try: m = float(v) == float(t)
            except ValueError: m = False
        else:
            m = v == t
        (ok if m else bad)(f"answers.md {k}: {'match' if m else 'differ'}")
        good &= m
    return good


def challenge(build, chal):
    print(f"Grading {build} and {chal} (read-only)")
    c = os.path.join(build, "CMakeCache.txt")
    if not os.path.isfile(c):
        bad(f"build: {c} not found"); return summary()
    (ok if (cache_val(build, "ENABLE_CJSON_TEST") or "").upper() in ("ON", "TRUE", "1") else bad)("build: tests enabled (ENABLE_CJSON_TEST)")
    check_instrumentation(build)
    check_compile_commands(build)
    check_ubsan_fatal(build)
    check_tests_pass(build)
    ev = os.path.join(chal, "evidence.txt")
    (ok if os.path.isfile(ev) and os.path.getsize(ev) > 0 else bad)("evidence.txt: present and non-empty")
    check_answers(build, chal)
    return summary()


def tree_hash(d):
    h = hashlib.sha256()
    for root, dirs, files in os.walk(d):
        dirs.sort()
        for f in sorted(files):
            p = os.path.join(root, f)
            h.update(p.encode())
            try:
                h.update(open(p, "rb").read())
            except OSError:
                pass
    return h.hexdigest()


def make_mutant(dst):
    shutil.copytree("/src/cjson", dst, symlinks=True)
    for r, d, f in os.walk(dst):
        for n in d + f:
            try: os.chmod(os.path.join(r, n), 0o755 if n in d else 0o644)
            except OSError: pass
    os.chmod(dst, 0o755)
    p = os.path.join(dst, "CMakeLists.txt")
    lines = open(p).read().split("\n")
    i = next(i for i, l in enumerate(lines) if l.startswith("include(GNUInstallDirs)"))
    lines.insert(i, "add_compile_options(-fno-sanitize=address)")
    open(p, "w").write("\n".join(lines))


def run_script(script, src, work):
    return run(["bash", script, src, work], timeout=300)


def project(script):
    print(f"Grading {script} (read-only; it is run with /src/cjson as source and a fresh work dir)")
    if not os.path.isfile(script):
        bad(f"script: {script} not found"); return summary()
    (ok if os.access(script, os.X_OK) else bad)("script: executable")
    pre = tree_hash("/src/cjson"); g0 = run(["git", "-C", "/src/cjson", "status", "--porcelain"], env=dict(ENV, GIT_OPTIONAL_LOCKS="0")).stdout
    for i in (1, 2):
        w = tempfile.mkdtemp(prefix="osvr-w")
        p = run_script(script, "/src/cjson", w)
        if p.returncode != 0:
            bad(f"run {i}: exit status {p.returncode}. Last lines: " + " | ".join(p.stdout.strip().splitlines()[-2:])); continue
        ok(f"run {i}: exit 0")
        last = [l for l in p.stdout.strip().splitlines() if l.strip()][-1:] or [""]
        m = re.match(r"BUILD_DIR=(.+)$", last[0].strip())
        if not m:
            bad(f"run {i}: the last output line must be BUILD_DIR=<path>"); continue
        b = m.group(1)
        if not os.path.isdir(b):
            bad(f"run {i}: BUILD_DIR {b} does not exist"); continue
        check_instrumentation(b)
        check_ubsan_fatal(b)
        check_tests_pass(b)
        shutil.rmtree(w, ignore_errors=True)
    # mutant: same sources, but the compile step silently loses -fsanitize=address while the link keeps the runtime
    mt = tempfile.mkdtemp(prefix="osvr-m"); mdir = os.path.join(mt, "cjson")
    make_mutant(mdir)
    w = tempfile.mkdtemp(prefix="osvr-w")
    p = run_script(script, mdir, w)
    pe = [os.path.join(r, "parse_examples") for r, _, fs in os.walk(w) if "parse_examples" in fs and os.access(os.path.join(r, "parse_examples"), os.X_OK) and not os.path.isdir(os.path.join(r, "parse_examples"))]
    a, ld = (count(pe[0], "__asan_report"), run(["ldd", pe[0]]).stdout) if pe else (None, "")
    if p.returncode == 0:
        if a is not None and a > 0:
            ok(f"verify stage: script accepted the mutated tree, but its build in the work dir has {a} __asan_report symbols (the mutation did not remove instrumentation), so accepting it is legitimate")
        else:
            bad("verify stage: script ACCEPTS a source tree whose objects lack ASan instrumentation (exit 0" + ("" if pe else "; no parse_examples under WORKDIR to inspect") + ")")
    elif not pe:
        bad(f"verify stage: script exited {p.returncode} on the mutated tree, but no parse_examples was left under WORKDIR. Build under WORKDIR and keep the build tree when verification fails (a refusal before the build does not count)")
    elif a == 0 and "libasan" in ld:
        ok(f"verify stage: script built the mutant (parse_examples: libasan linked, 0 __asan_report) and then rejected it (exit {p.returncode})")
    else:
        bad(f"verify stage: script exited {p.returncode} but the mutant build in its work dir is not the expected one (__asan_report={a}, libasan {'linked' if 'libasan' in ld else 'not linked'})")
    shutil.rmtree(mt, ignore_errors=True); shutil.rmtree(w, ignore_errors=True)
    post = tree_hash("/src/cjson"); g1 = run(["git", "-C", "/src/cjson", "status", "--porcelain"], env=dict(ENV, GIT_OPTIONAL_LOCKS="0")).stdout
    (ok if (pre == post and g0 == g1 == "") else bad)("/src/cjson: unchanged by your script")
    return summary()


def summary():
    if fails:
        print(f"SUMMARY: {fails} check(s) failed"); return 1
    print("SUMMARY: all checks passed"); return 0


def exitcode(label, got, want):
    global fails
    if got == want:
        print(f"HEALTH ok   {label}: exit {got}")
    else:
        fails += 1
        print(f"HEALTH FAIL {label}: exit {got}, expected {want}")


def health(lt):
    """Self-test with fixtures. Writes only to temp dirs; asserts exact exit codes."""
    global fails
    me = os.path.abspath(__file__)
    def subo(*args):
        r = subprocess.run([sys.executable, me] + list(args), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        return r.returncode, r.stdout
    def sub(*args):
        return subo(*args)[0]
    t = tempfile.mkdtemp(prefix="osvr-h")
    # reference build via the reference script
    w = os.path.join(t, "w"); p = run(["bash", os.path.join(lt, "ref-build-asan.sh"), "/src/cjson", w], timeout=300)
    m = re.search(r"BUILD_DIR=(.+)$", p.stdout.strip().splitlines()[-1] if p.stdout.strip() else "")
    exitcode("reference script", p.returncode, 0)
    if not m:
        print("HEALTH FAIL no BUILD_DIR from reference script"); return 1
    b = m.group(1)
    ch = os.path.join(t, "chal"); os.makedirs(ch)
    open(os.path.join(ch, "evidence.txt"), "w").write("fixture\n")
    truth = "test_function: file_test3_should_be_parsed_and_printed\ninput_file: inputs/test3\njson_key: width\nparsed_value: 500\n"
    open(os.path.join(ch, "answers.md"), "w").write(truth)
    exitcode("challenge: correct build and answers", sub("challenge", b, ch), 0)
    open(os.path.join(ch, "answers.md"), "w").write(truth.replace("width", "height"))
    exitcode("challenge: wrong json_key", sub("challenge", b, ch), 1)
    open(os.path.join(ch, "answers.md"), "w").write(truth)
    # trap build: documented option, no explicit sanitizer flags
    src = os.path.join(t, "trap-src"); shutil.copytree("/src/cjson", src, symlinks=True)
    os.chmod(src, 0o755)
    for r, d, f in os.walk(src):
        for n in d + f:
            try: os.chmod(os.path.join(r, n), 0o755 if n in d else 0o644)
            except OSError: pass
    tb = os.path.join(src, "build-doc")
    run(["cmake", "-S", src, "-B", tb, "-DCMAKE_BUILD_TYPE=Debug", "-DENABLE_SANITIZERS=ON", "-DENABLE_CJSON_TEST=ON", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DCMAKE_C_FLAGS=-g -O0 -fno-omit-frame-pointer"])
    run(["cmake", "--build", tb, "-j4"], timeout=300)
    if not os.path.isfile(os.path.join(tb, "cJSON_test")):
        fails += 1; print("HEALTH FAIL trap build (ENABLE_SANITIZERS=ON) was not built")
    exitcode("challenge: ENABLE_SANITIZERS=ON build (no ASan)", sub("challenge", tb, ch), 1)
    # option plus the learner's own -fsanitize=address: cJSON appends -fsanitize=undefined -fno-sanitize-recover itself
    ob = os.path.join(src, "build-opt")
    cp = run(["cmake", "-S", src, "-B", ob, "-DCMAKE_BUILD_TYPE=Debug", "-DENABLE_SANITIZERS=ON", "-DENABLE_CJSON_TEST=ON", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DCMAKE_C_FLAGS=-g -O0 -fno-omit-frame-pointer -fsanitize=address"])
    if not os.path.isfile(os.path.join(ob, "CMakeCache.txt")): print("    | cmake configure failed: " + cp.stdout[-500:].replace("\n", " / "))
    run(["cmake", "--build", ob, "-j4"], timeout=300)
    rc, out = subo("challenge", ob, ch)
    exitcode("challenge: ENABLE_SANITIZERS=ON plus own -fsanitize=address", rc, 0)
    if rc != 0:
        print("\n".join("    | " + l for l in out.splitlines() if l.startswith("FAIL")))
    for needle in ("PASS  ubsan fatal:", "PASS  instrumentation:"):
        if needle not in out:
            fails += 1; print(f"HEALTH FAIL expected line missing: {needle}")
    exitcode("challenge: missing build dir", sub("challenge", os.path.join(t, "nope"), ch), 1)
    exitcode("project: reference script", sub("project", os.path.join(lt, "ref-build-asan.sh")), 0)
    exitcode("project: weak verify stage", sub("project", os.path.join(lt, "weak-build-asan.sh")), 1)
    exitcode("project: deletes its work dir when verification fails", sub("project", os.path.join(lt, "cleanup-build-asan.sh")), 1)
    exitcode("project: no -fno-sanitize-recover (UBSan not fatal)", sub("project", os.path.join(lt, "norecover-build-asan.sh")), 1)
    exitcode("project: removes the mutation from its own SRC copy (legitimately accepts)", sub("project", os.path.join(lt, "unmutate-build-asan.sh")), 0)
    exitcode("project: refuses the mutated SRC in its pin stage", sub("project", os.path.join(lt, "pinrefuse-build-asan.sh")), 1)
    # mystery-check fixtures
    mdir = "/opt/osvr/fnd03/tools/mystery-check"
    good = "m1: asan_code=yes asan_runtime=yes ubsan=yes debug_info=yes opt=O0 evidence: x\nm2: asan_code=no asan_runtime=yes ubsan=no debug_info=yes opt=O0\nm3: asan_code=no asan_runtime=no ubsan=yes debug_info=yes opt=O0\nm4: asan_code=yes asan_runtime=yes ubsan=no debug_info=no opt=O0\nm5: asan_code=no asan_runtime=no ubsan=no debug_info=yes opt=O0\nm6: asan_code=yes asan_runtime=yes ubsan=yes debug_info=no opt=O2\n"
    f = os.path.join(t, "mystery.txt"); open(f, "w").write(good)
    rc = subprocess.run([mdir, f], stdout=subprocess.DEVNULL).returncode
    exitcode("mystery-check: correct key", rc, 0)
    open(f, "w").write(good.replace("m4: asan_code=yes asan_runtime=yes ubsan=no debug_info=no", "m4: asan_code=yes asan_runtime=yes ubsan=no debug_info=yes"))
    exitcode("mystery-check: debug_info trap answered wrongly", subprocess.run([mdir, f], stdout=subprocess.DEVNULL).returncode, 1)
    shutil.rmtree(t, ignore_errors=True)
    print("HEALTH OK" if not fails else f"HEALTH FAILED ({fails})")
    return 1 if fails else 0


def main(a):
    if len(a) >= 2 and a[1] == "challenge":
        return challenge(a[2] if len(a) > 2 else "/work/fnd03/cjson/build-asan", a[3] if len(a) > 3 else "/work/fnd03/challenge")
    if len(a) >= 2 and a[1] == "project":
        return project(a[2] if len(a) > 2 else "/work/fnd03/project/build-asan.sh")
    if len(a) == 3 and a[1] == "health":
        return health(a[2])
    print(__doc__, file=sys.stderr); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
