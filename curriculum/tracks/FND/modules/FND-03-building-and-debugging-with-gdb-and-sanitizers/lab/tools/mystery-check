#!/usr/bin/env python3
"""mystery-check FILE   (Drill 2)
FILE has one line per binary:
  m1: asan_code=yes|no asan_runtime=yes|no ubsan=yes|no debug_info=yes|no opt=O0|O2 evidence: ...
Prints match/differ per field, never the expected value. Exit 0 only if all 30 fields match,
1 if any differ or are missing, 2 on usage error. The key is stored as salted hashes."""
import hashlib, os, re, sys

FIELDS = ["asan_code", "asan_runtime", "ubsan", "debug_info", "opt"]
KEY = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".mystery-key")


def h(salt, name, field, value):
    return hashlib.sha256(f"{salt}|{name}|{field}|{value}".encode()).hexdigest()


def main(argv):
    if len(argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        lines = open(argv[1], encoding="utf-8").read().splitlines()
        keyl = open(KEY).read().split()
    except OSError as e:
        print(f"cannot read: {e}", file=sys.stderr)
        return 2
    salt, hashes = keyl[0], set(keyl[1:])
    got = {}
    for l in lines:
        m = re.match(r"\s*(m[1-6])\s*:(.*)$", l)
        if m:
            body = m.group(2).split("evidence:")[0]
            got[m.group(1)] = dict(re.findall(r"(\w+)=(\w+)", body))
    bad = 0
    for n in ["m1", "m2", "m3", "m4", "m5", "m6"]:
        row = []
        for f in FIELDS:
            v = got.get(n, {}).get(f)
            if v is None:
                r = "missing"
            else:
                r = "match" if h(salt, n, f, v.strip().lower() if f != "opt" else v.strip().upper()) in hashes else "differ"
            if r != "match":
                bad += 1
            row.append(f"{f}={r}")
        print(f"{n}: " + " ".join(row))
    print("ALL MATCH" if not bad else f"{bad} field(s) not matching")
    return 0 if not bad else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
