# osvr-fnd02-iperf:1 -- the real-bug harness step of FND-02 (check.sh realbug). Not needed by check.sh repro or hardening.
# Builds iperf3 with AddressSanitizer at the vulnerable parent commit and at the fix commit.
#   IPERF=1 ./build.sh     (or: <engine> build -t osvr-fnd02-iperf:1 -f Dockerfile.iperf .; needs the network; osvr-fnd02:1 must exist)
# Run with --network=none; the tests run from the build directory (they read public.pem/private.pem there):
#   <engine> run --rm --network=none osvr-fnd02-iperf:1 sh -c 'cd /src/iperf-vuln/src && ./t_auth; echo exit=$?'
# Build trees: /src/iperf-vuln (4eab661d) and /src/iperf-fixed (4e5313ba), each with an ASan-built src/iperf_auth.o.
# The learner's harness is compiled and run by /opt/osvr/fnd02/tools/realbug.py (same build line as check.sh realbug).
# User: root (see the base image notes).
FROM osvr-fnd02:1

ARG IPERF_FIX=4e5313bab0b9b3fe03513ab54f722c8a3e4b7bdf
ARG IPERF_PARENT=4eab661da0bbaac04493fa40164e928c6df7934a

RUN apt-get update \
 && apt-get install -y --no-install-recommends libssl-dev autoconf automake libtool pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && dpkg-query -W -f='${Package}=${Version}\n' libssl-dev autoconf automake libtool > /etc/osvr-iperf-packages.txt

RUN set -e; \
    for v in vuln:$IPERF_PARENT fixed:$IPERF_FIX; do \
      name=${v%%:*}; commit=${v##*:}; \
      git clone --quiet --no-hardlinks /src/iperf /src/iperf-$name; \
      git -C /src/iperf-$name -c advice.detachedHead=false checkout --quiet "$commit"; \
      test "$(git -C /src/iperf-$name rev-parse HEAD)" = "$commit"; \
      ( cd /src/iperf-$name && ./bootstrap.sh >/dev/null 2>&1 \
        && ./configure --quiet CFLAGS="-g -O1 -fsanitize=address -fno-omit-frame-pointer" LDFLAGS="-fsanitize=address" >/dev/null \
        && make -j"$(nproc)" >/dev/null 2>&1 ); \
      test -x /src/iperf-$name/src/t_auth || { echo "t_auth not built in $name"; exit 1; }; \
    done
