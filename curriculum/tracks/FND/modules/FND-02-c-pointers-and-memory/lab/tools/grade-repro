#!/usr/bin/env python3
"""grade-repro [repro|hardening|realbug] DIR   (runs inside the image; DIR holds repro.c and predicted.txt)
realbug: DIR holds harness.c; needs the osvr-fnd02-iperf:1 image (IPERF=1 ./build.sh).
Prints PASS/FAIL per check with a one-line informational reason. It does not explain the bug."""
import os, re, subprocess, sys, tempfile
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import asanparse

ASAN = ["-g", "-O0", "-fno-omit-frame-pointer", "-fsanitize=address,undefined"]
fails = 0


def ok(m):
    print("PASS ", m)


def bad(m):
    global fails
    fails += 1
    print("FAIL ", m)


def sh(cmd, **kw):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace", **kw)


def run(binpath):
    env = dict(os.environ, ASAN_OPTIONS="detect_leaks=0")
    try:
        return subprocess.run([binpath], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                              errors="replace", timeout=20, env=env)
    except subprocess.TimeoutExpired:
        return None


def repro(d):
    src = os.path.join(d, "repro.c")
    pred = os.path.join(d, "predicted.txt")
    tmp = tempfile.mkdtemp()
    if not os.path.isfile(src):
        bad(f"repro.c: not found in {d}")
        return
    text = open(src, encoding="utf-8", errors="replace").read()
    n = text.count("\n") + (0 if text.endswith("\n") or not text else 1)
    ok(f"repro.c: {n} lines") if n < 60 else bad(f"repro.c: {n} lines, limit is under 60")
    if re.search(r'#\s*include\s*[<"]openssl', text):
        bad("repro.c: includes an OpenSSL header (libc only)")
    else:
        ok("repro.c: no OpenSSL header")

    b = os.path.join(tmp, "repro.asan")
    c = sh(["gcc", *ASAN, "-Wall", "-Wextra", src, "-o", b])
    if not os.path.exists(b):
        bad("compile: failed. First lines: " + " | ".join(c.stdout.splitlines()[:3]))
        return
    w = sum(1 for l in c.stdout.splitlines() if "warning:" in l)
    ok(f"compile: ok, {w} warning(s) (warnings do not fail the check)")

    r = run(b)
    if r is None:
        bad("run: vulnerable build timed out")
        return
    rep = asanparse.parse(r.stderr)
    if rep is None:
        bad(f"report: no AddressSanitizer report (exit status {r.returncode})")
    else:
        ok("report: heap-buffer-overflow") if rep["kind"] == "heap-buffer-overflow" else bad(f"report: error kind is {rep['kind']}")
        ok("report: WRITE of size 1") if (rep.get("op"), rep.get("size")) == ("WRITE", 1) else bad(f"report: access is {rep.get('op')} of size {rep.get('size')}")
        off, reg = rep.get("offset"), rep.get("region")
        if off and off[0] == 0 and off[1] == "after" and reg and reg >= 2:
            ok(f"report: located 0 bytes after {reg}-byte region")
        else:
            bad(f"report: location is {off} region {reg}; need 0 bytes after a region of at least 2 bytes")
        f0, al = rep.get("frame0"), rep.get("alloc")
        if f0 and al:
            if f0[0] == al[0]:
                bad("shape: allocation and overflowing write are in the same function")
            else:
                ok(f"shape: write in {f0[0]}, allocation in {al[0]} (different functions)")
        else:
            bad("shape: could not read frame #0 or the allocation stack")

    fb = os.path.join(tmp, "repro.fixed")
    c = sh(["gcc", *ASAN, "-DFIXED", src, "-o", fb])
    if not os.path.exists(fb):
        bad("fixed: -DFIXED build does not compile")
    else:
        r2 = run(fb)
        if r2 is None:
            bad("fixed: run timed out")
        elif r2.returncode == 0 and "AddressSanitizer" not in r2.stderr:
            ok("fixed: -DFIXED exits 0, no AddressSanitizer output")
        else:
            bad(f"fixed: -DFIXED exit status {r2.returncode}" + (", AddressSanitizer output present" if "AddressSanitizer" in r2.stderr else ""))

    if os.path.isfile(pred) and os.path.getsize(pred) > 0:
        ptxt = open(pred, encoding="utf-8", errors="replace").read()
        outtxt = (r.stderr + r.stdout) if r else ""
        addrs = set(re.findall(r"0x[0-9a-fA-F]{6,}", ptxt)) & set(re.findall(r"0x[0-9a-fA-F]{6,}", outtxt))
        if addrs:
            bad("predicted.txt: contains address(es) that appear in the run output (heuristic: was it pasted?)")
        else:
            ok("predicted.txt: present, no address copied from the run (heuristic only)")
    else:
        bad("predicted.txt: missing or empty (write it before you run)")


def realbug(d):
    import realbug as rb
    src = os.path.join(d, "harness.c")
    if not os.path.isfile(src):
        bad(f"harness.c: not found in {d}")
        return
    if not rb.available():
        bad("iperf ASan build trees not found: run this in osvr-fnd02-iperf:1 (IPERF=1 ./build.sh)")
        return
    ok("harness.c: found")
    tmp = tempfile.mkdtemp()
    res = {}
    for v in ("vuln", "fixed"):
        tree, short = rb.TREES[v]
        exe, out = rb.build(v, src, tmp)
        if exe is None:
            bad(f"compile {v} ({short}): failed. First lines: " + " | ".join(out.splitlines()[:3]))
            continue
        ok(f"compile {v} ({short}): ok")
        r = rb.run(v, exe, tmp)
        if r is None:
            bad(f"run {v} ({short}): timed out")
            continue
        res[v] = (r, asanparse.parse(r.stderr))
    if "vuln" in res:
        r, rep = res["vuln"]
        if rep is None:
            bad(f"vuln 4eab661d: no AddressSanitizer report (exit status {r.returncode})")
        else:
            ok("vuln 4eab661d: heap-buffer-overflow") if rep["kind"] == "heap-buffer-overflow" else bad(f"vuln 4eab661d: error kind is {rep['kind']}")
            ok("vuln 4eab661d: WRITE of size 1") if (rep.get("op"), rep.get("size")) == ("WRITE", 1) else bad(f"vuln 4eab661d: access is {rep.get('op')} of size {rep.get('size')}")
            f0 = rep.get("frame0")
            if f0 == ("decode_auth_setting", 390):
                ok("vuln 4eab661d: access at decode_auth_setting iperf_auth.c:390")
            else:
                bad(f"vuln 4eab661d: access at {f0[0] + ' line ' + str(f0[1]) if f0 else 'unknown frame'}, need decode_auth_setting iperf_auth.c:390")
            al, off, reg = rep.get("alloc"), rep.get("offset"), rep.get("region")
            if off and reg and al:
                print(f"INFO  vuln 4eab661d: access is {off[0]} bytes {off[1]} a {reg}-byte object allocated in {al[0]}"
                      + (f":{al[1]}" if al[1] else ""))
    if "fixed" in res:
        r, rep = res["fixed"]
        if rep is None:
            ok(f"fixed 4e5313ba: no AddressSanitizer report (exit status {r.returncode})")
        else:
            bad(f"fixed 4e5313ba: AddressSanitizer reports {rep['kind']}")


def hardening(d):
    src = os.path.join(d, "repro.c")
    if not os.path.isfile(src):
        print(f"repro.c not found in {d}")
        return 1
    tmp = tempfile.mkdtemp()
    builds = {"default": ["-g", "-O0"],
              "weak": ["-g", "-O0", "-fno-stack-protector", "-no-pie", "-Wl,-z,norelro", "-D_FORTIFY_SOURCE=0"]}
    for name, fl in builds.items():
        b = os.path.join(tmp, "repro." + name)
        c = sh(["gcc", *fl, src, "-o", b])
        print(f"== {name}: gcc {' '.join(fl)}")
        if not os.path.exists(b):
            print("   compile failed:", c.stdout[:200]); continue
        def grep(cmd, pat):
            o = sh(cmd).stdout.splitlines()
            m = [l.strip() for l in o if re.search(pat, l)]
            return m or ["(none)"]
        print("   PIE   :", grep(["readelf", "-h", b], r"Type:")[0])
        print("   NX    :", grep(["readelf", "-lW", b], r"GNU_STACK")[0])
        print("   RELRO :", grep(["readelf", "-lW", b], r"GNU_RELRO")[0])
        print("   BIND  :", "; ".join(grep(["readelf", "-dW", b], r"BIND_NOW|FLAGS")))
        n = len([l for l in sh(["readelf", "-sW", b]).stdout.splitlines() if "__stack_chk_fail" in l])
        print(f"   canary: __stack_chk_fail symbols: {n}")
        r = run(b)
        print(f"   run   : exit status {r.returncode if r else 'timeout'}; stdout={r.stdout.strip()!r}; stderr={r.stderr.strip()[:200]!r}" if r else "   run   : timeout")
    return 0


def main():
    mode, d = (sys.argv[1], sys.argv[2]) if len(sys.argv) == 3 else ("repro", sys.argv[1])
    if mode == "hardening":
        return hardening(d)
    if mode == "realbug":
        realbug(d)
        print("ALL CHECKS PASSED" if not fails else f"{fails} check(s) failed")
        return 1 if fails else 0
    repro(d)
    print("ALL CHECKS PASSED" if not fails else f"{fails} check(s) failed")
    return 1 if fails else 0


sys.exit(main())
