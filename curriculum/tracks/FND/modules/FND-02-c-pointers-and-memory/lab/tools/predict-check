#!/usr/bin/env python3
"""predict-check PRED_FILE -- CMD [ARGS...]

Run CMD, parse its first AddressSanitizer report, and compare it with a prediction.
PRED_FILE: one 'key: value' per line; unknown keys ignored; '#' starts a comment.
Keys:
  kind     heap-buffer-overflow, stack-buffer-overflow, ...
  op       READ or WRITE
  size     access size in bytes
  offset   '0 bytes after', '4 before' or '3 inside' (first number and the word after/before/inside)
  region   size in bytes of the object (heap block; stack frame object [a, b); global variable size)
  frame0   function:line of the first frame that is not a sanitizer interceptor or libc frame
           (the first frame in your program's own source), e.g. dup_upper:17.
           When the access happens inside memset, snprintf or another interceptor, frame0 is
           the caller in your code, not the interceptor.
  alloc    heap: first non-allocator function:line of the allocation stack.
           stack or global: the variable name, e.g. scores, table
Global-variable reports ("N bytes after global variable 'NAME' ... of size S") give
offset = N, alloc = NAME, region = S.
Any UBSan 'runtime error:' line is printed verbatim.
Exit: 0 report found, 1 no ASan report in the output, 2 usage error. --help prints this text, exit 0.
This tool compares fields; it does not explain them.
"""
import re
import subprocess
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import asanparse  # noqa: E402

FIELDS = ["kind", "op", "size", "offset", "region", "frame0", "alloc"]


def norm_loc(s):
    s = str(s)
    ident = re.search(r"[A-Za-z_]\w*", s)
    nums = re.findall(r"\d+", s)
    return (ident.group(0) if ident else s.strip(), nums[-1] if nums else None)


def actual_str(rep, k):
    v = rep.get(k)
    if v is None:
        return None
    if k == "offset":
        return f"{v[0]} {v[1]}"
    if k in ("frame0", "alloc"):
        return f"{v[0]}:{v[1]}" if v[1] is not None else v[0]
    return str(v)


def same(k, pred, rep):
    a = rep.get(k)
    p = pred.strip()
    if k in ("kind",):
        return p.lower() == a.lower()
    if k == "op":
        return p.upper() == a
    if k in ("size", "region"):
        return re.sub(r"\D", "", p) == str(a)
    if k == "offset":
        n = re.search(r"\d+", p)
        w = re.search(r"after|before|inside", p, re.I)
        return bool(n and w) and int(n.group(0)) == a[0] and w.group(0).lower() == a[1]
    if k in ("frame0", "alloc"):
        pi, pn = norm_loc(p)
        if a[1] is None:
            return pi == a[0]
        return pi == a[0] and pn == str(a[1])
    return False


def main(argv):
    if len(argv) == 2 and argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if "--" not in argv or len(argv) < 4 or argv.index("--") != 2:
        print(__doc__, file=sys.stderr)
        return 2
    pred_file, cmd = argv[1], argv[3:]
    pred = {}
    try:
        for line in open(pred_file, encoding="utf-8"):
            line = line.split("#", 1)[0]
            if ":" in line:
                k, v = line.split(":", 1)
                pred[k.strip().lower()] = v.strip()
    except OSError as e:
        print(f"cannot read {pred_file}: {e}", file=sys.stderr)
        return 2
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, errors="replace")
    rep = asanparse.parse(p.stdout)
    if rep is None:
        print(f"no AddressSanitizer report in the output (exit status {p.returncode})")
        return 1
    for u in rep["ubsan"]:
        print("UBSan:", u)
    print(f"{'field':8} {'predicted':28} {'actual':28} result")
    for k in FIELDS:
        act = actual_str(rep, k)
        if k not in pred:
            res, pv = "not predicted", "-"
        elif act is None:
            res, pv = "n/a", pred[k]
        else:
            pv = pred[k]
            res = "match" if same(k, pv, rep) else "differ"
        print(f"{k:8} {pv:28} {str(act):28} {res}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
